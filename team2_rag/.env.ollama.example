# Local, free LLM via Ollama (https://ollama.com). No API key, no secrets.
# Copy these lines into your real `.env` (git-ignored) / the repo-level `.env.example`.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Ollama's OpenAI-compatible endpoint (default shown).
OLLAMA_BASE_URL=http://localhost:11434/v1
# MUST match the context length the Ollama SERVER runs the model with: the /v1 API cannot set num_ctx per request,
# and Ollama silently truncates prompts that exceed it. Start the server with OLLAMA_CONTEXT_LENGTH=8192 (or a Modelfile).
LLM_CONTEXT_WINDOW_TOKENS=8192
# Local inference is slower than a hosted API (cold start + CPU generation). Remote providers stay capped at 30s; ollama allows up to 600s.
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
# Leave more of the window for sources (small local model; default is 1500).
LLM_MAX_OUTPUT_TOKENS=800
