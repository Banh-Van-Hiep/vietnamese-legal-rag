{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "title": "RAG Query Request",
  "description": "Request payload for POST /api/v1/query.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question"],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "description": "User question. Whitespace-only validation is an API-level responsibility."
    }
  },
  "examples": [
    {
      "question": "Người lao động được nghỉ phép bao nhiêu ngày?"
    }
  ]
}