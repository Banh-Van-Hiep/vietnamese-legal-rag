{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.schema.json",
  "title": "Selected RAG Context",
  "description": "Ordered, budgeted context retaining chunk provenance and ranking scores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "token_budget", "estimated_tokens", "chunks", "groups"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "token_budget": { "type": "integer", "minimum": 0 },
    "estimated_tokens": { "type": "integer", "minimum": 0 },
    "chunks": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextChunk" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextGroup" }
    }
  },
  "$defs": {
    "contextChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "content", "document", "article", "clause", "source", "retrieval_score", "rerank_score", "position"],
      "properties": {
        "chunk_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "minLength": 1 },
        "article": { "type": "string", "minLength": 1 },
        "clause": { "type": ["string", "null"] },
        "source": { "type": "string", "minLength": 1 },
        "retrieval_score": { "type": "number" },
        "rerank_score": { "type": "number" },
        "position": { "type": "integer", "minimum": 1 }
      }
    },
    "contextGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "article", "chunk_ids"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "article": { "type": "string", "minLength": 1 },
        "chunk_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "examples": [
    {
      "question": "Người lao động được nghỉ phép bao nhiêu ngày?",
      "token_budget": 3000,
      "estimated_tokens": 180,
      "chunks": [
        {
          "chunk_id": "chunk-example-001",
          "content": "Example legal text supplied by the retrieval system.",
          "document": "Example document",
          "article": "Example article",
          "clause": null,
          "source": "example-source",
          "retrieval_score": 0.72,
          "rerank_score": 0.91,
          "position": 1
        }
      ],
      "groups": [
        {
          "document": "Example document",
          "article": "Example article",
          "chunk_ids": ["chunk-example-001"]
        }
      ]
    }
  ]
}