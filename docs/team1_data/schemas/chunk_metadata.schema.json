{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chunk_metadata.schema.json",
  "title": "Legal Chunk Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id",
    "document",
    "chapter",
    "article",
    "clause",
    "content",
    "source"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "string",
      "minLength": 1
    },
    "article": {
      "type": "string",
      "minLength": 1
    },
    "clause": {
      "type": ["string", "null"]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}