# Sao chép thành .env. Vite chỉ đọc biến bắt đầu bằng VITE_.
# Địa chỉ backend. Phải nằm trong CORS_ALLOWED_ORIGINS của backend khi chạy từ origin của FE (mặc định http://localhost:5173).
VITE_API_URL=http://localhost:8080
# true: hiện nhãn "Dữ liệu thử nghiệm" vì backend đang dùng mock. Đặt false khi nối dữ liệu thật.
VITE_MOCK_MODE=true
