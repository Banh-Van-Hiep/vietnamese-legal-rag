# Sao chép thành .env. Vite chỉ đọc biến bắt đầu bằng VITE_.
# Main UI dùng Backend profile rag/v2.0. CORS_ALLOWED_ORIGINS của Backend chứa origin FE (mặc định http://localhost:5173).
VITE_API_URL=http://localhost:8080
# Chỉ điều khiển nhãn thử nghiệm, không đổi API/transport hoặc profile Backend. Giữ true với fixture; false chỉ khi nối dữ liệu thật.
VITE_MOCK_MODE=true
# Thông tin "Phạm vi dữ liệu" ở màn hình chào (VLRA-43). Ghi đúng bản dữ liệu đã phát hành; để trống thì hiện "Chưa công bố".
# VITE_CORPUS_SCOPE=Pháp luật doanh nghiệp: Luật Doanh nghiệp và các văn bản hướng dẫn trong bộ dữ liệu của dự án
# VITE_CORPUS_SNAPSHOT=
