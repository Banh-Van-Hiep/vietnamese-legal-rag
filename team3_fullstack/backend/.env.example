# Copy to .env. run-local.ps1 loads this file; Spring does not read .env itself.
# Precedence: -Port/-AllowedOrigins > process environment > .env > Spring defaults.
# Invalid selected values fail; a valid lower-priority value does not hide the error.
# You can select another file with -EnvFile; .env is optional when using process variables.
# Set JAVA_HOME to your actual JDK 25 installation when Maven uses another JDK.
# JAVA_HOME=D:/Java/jdk-25
SPRING_PROFILES_ACTIVE=mock
# If 8080 is busy: run-local.ps1 -Port 8081 (does not change this file).
SERVER_PORT=8080
# Explicit http(s) origins, separated by commas; no wildcard or URL path.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# answered or insufficient_context; applies to new turns, not saved replays.
MOCK_ANSWER_STATUS=answered
# Optional T02 selectors; absent query selector uses MOCK_ANSWER_STATUS; article defaults to success.
# Change selectors and restart; no extra field/header/endpoint is needed on public requests.
# MOCK_QUERY_SCENARIO=answered
# Query: answered, insufficient_context, internal_error, service_unavailable, upstream_timeout.
# MOCK_ARTICLE_SCENARIO=success
# Article: success, internal_error, service_unavailable, upstream_timeout.
