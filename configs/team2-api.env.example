# Copy these integration settings into the local .env; do not commit real keys.
# Paths are resolved from the repository root. Both manifests need the same version.
RAG_CHUNKS=data/doanh-nghiep/processed/chunks.jsonl
# Complete articles supplied by Team 1; no fallback to chunks.
RAG_ARTICLES=data/doanh-nghiep/processed/articles.jsonl
RAG_BM25_INDEX=data/index/bm25/week4-v1
RAG_DENSE_INDEX=data/index/dense/week4-v1
RAG_QDRANT_URL=http://localhost:6333
# Optional persistent local Qdrant (takes precedence over the URL):
# RAG_QDRANT_PATH=data/index/qdrant

# Person 2 supplies the actual provider/model and API key (VLRA-46).
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
