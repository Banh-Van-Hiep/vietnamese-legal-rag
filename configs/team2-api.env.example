# Copy these integration settings into the local .env; do not commit real keys.
# Paths are resolved from the repository root. Both manifests need the same version.
RAG_CHUNKS=data/doanh-nghiep/processed/chunks.jsonl
RAG_BM25_INDEX=data/index/bm25/week4-v1
RAG_DENSE_INDEX=data/index/dense/week4-v1
RAG_QDRANT_URL=http://localhost:6333
# Optional persistent local Qdrant (takes precedence over the URL):
# RAG_QDRANT_PATH=data/index/qdrant

# Person 2 supplies the actual provider/model and API key (VLRA-46).
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
# LLM_ALLOW_FALLBACK=true         # false: tắt model dự phòng, chỉ dùng đúng LLM_MODEL (bắt buộc khi đo benchmark)

# Pipeline v2 (VLRA-67). Every line below is optional; the value shown is the default actually used.
# The startup log `rag_config` prints the effective values, so reports can quote them.
# RAG_TOP_K=10
# RAG_BM25_WEIGHT=0.5            # BM25:Dense = 0.5:1 (retrieval_v2.json of Team 1)
# RAG_DENSE_WEIGHT=1.0
# RAG_RERANK=false               # false (mặc định): giữ thứ hạng Hybrid, tắt reranker để tối ưu độ trễ và recall
# RAG_RERANK_TRUNCATE=false      # true: cut long passages instead of failing at 512 tokens
# RAG_STRICT_RERANK=false        # false: fall back to the Hybrid order when reranking fails or times out
# RAG_RERANK_TIMEOUT_SECONDS=4
# RAG_BM25_ONLY=false            # true: chỉ BM25 + LLM, không Qdrant/BGE/rerank (chạy thử trên máy nhẹ)
# RAG_VERIFY_CLAIMS=false        # true: LLM khai claims và pipeline chạy verify_response (benchmark); tắt khi chạy online để giảm độ trễ
