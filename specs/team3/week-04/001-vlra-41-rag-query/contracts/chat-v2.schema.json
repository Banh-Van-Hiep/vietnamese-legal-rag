{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legal-rag:team3:chat:v2",
  "title": "Team3 public chat v2.0",
  "description": "Docs v2.0 section9. Semantic marker/history/state invariants are tested in Java. SSE event name selects Meta/Delta/Complete/Error; this root validates a request.",
  "type": "object",
  "$ref": "#/$defs/ChatRequest",
  "$defs": {
    "ChatRequest": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "conversationId": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "question",
        "clientRequestId"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "userMessageId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "assistantMessageId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "conversationId",
        "clientRequestId",
        "userMessageId",
        "assistantMessageId",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "citationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^C(?:[1-9]|10)$"
        },
        "chunkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "articleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "documentTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "article": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clause": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "point": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        }
      },
      "required": [
        "citationId",
        "chunkId",
        "documentId",
        "articleId",
        "documentTitle",
        "article",
        "clause",
        "point",
        "sourceUrl"
      ],
      "additionalProperties": false
    },
    "Delta": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Complete": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "userMessageId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "assistantMessageId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "answered",
            "insufficient_context"
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "citations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/Citation"
          }
        }
      },
      "required": [
        "conversationId",
        "clientRequestId",
        "userMessageId",
        "assistantMessageId",
        "createdAt",
        "status",
        "answer",
        "citations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "answered"
              }
            }
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "citations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
