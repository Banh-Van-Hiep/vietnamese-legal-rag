{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal QueryRequest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "history"],
  "properties": {
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "history": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 20000}
        }
      }
    }
  },
  "description": "Spec v2.0 section 9.8. Code additionally checks trimming, pairs, alternating roles, total history length, duplicate keys and request bytes."
}
