{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_request_id",
    "question"
  ],
  "properties": {
    "conversation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "client_request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "UUID v4 cho một lượt hỏi; Backend sở hữu chống gửi trùng."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "description": "Backend trim trước khi kiểm tra 1–2000 Unicode code point."
    }
  },
  "description": "Public FE → Backend. Không bao gồm history hoặc thông tin nội bộ RAG."
}
